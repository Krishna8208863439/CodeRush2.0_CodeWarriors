datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CITIZEN
  OFFICER
  SUPER_ADMIN
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GrievanceStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum FileType {
  IMAGE
  AUDIO
  DOC
}

model User {
  id                  String             @id @default(uuid())
  name                String?
  email               String             @unique
  emailVerified       DateTime?
  image               String?
  phone               String?
  passwordHash        String?
  role                Role               @default(CITIZEN)
  departmentId        String?
  department          Department?        @relation(fields: [departmentId], references: [id])
  accounts            Account[]
  grievancesSubmitted Grievance[]        @relation("CitizenGrievances")
  grievancesAssigned  Grievance[]        @relation("OfficerGrievances")
  historyEntries      GrievanceHistory[]
  isDeleted           Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Department {
  id          String      @id @default(uuid())
  name        String      @unique
  code        String      @unique
  SLA_hours   Int         @default(48)
  description String?
  users       User[]
  grievances  Grievance[]
  isDeleted   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Grievance {
  id                String             @id @default(uuid())
  ticketNumber      String             @unique @default(uuid())
  title             String
  description       String
  category          String             @default("PUBLIC_WORKS")
  latitude          Float?             @default(28.6139)
  longitude         Float?             @default(77.2090)
  location_lat      Float
  location_lng      Float
  address           String?
  status            GrievanceStatus    @default(PENDING)
  urgency           Urgency            @default(MEDIUM)
  priority          Urgency            @default(MEDIUM)
  priorityScore     Float              @default(1.0)
  requestCount      Int                @default(1)
  reportCount       Int                @default(1)
  masterIssueId     String?
  masterIssue       Grievance?         @relation("DuplicateGrievances", fields: [masterIssueId], references: [id])
  duplicateIssues   Grievance[]        @relation("DuplicateGrievances")
  citizenId         String
  citizen           User               @relation("CitizenGrievances", fields: [citizenId], references: [id], onDelete: Cascade)
  departmentId      String?
  department        Department?        @relation(fields: [departmentId], references: [id])
  assignedOfficerId String?
  assignedOfficer   User?              @relation("OfficerGrievances", fields: [assignedOfficerId], references: [id])
  evidence          Evidence[]
  history           GrievanceHistory[]
  priorityAuditLogs PriorityAuditLog[]
  isDeleted         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model GrievanceHistory {
  id             String           @id @default(uuid())
  grievanceId    String
  grievance      Grievance        @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  changedById    String?
  changedBy      User?            @relation(fields: [changedById], references: [id])
  previousStatus GrievanceStatus?
  newStatus      GrievanceStatus
  remarks        String?
  timestamp      DateTime         @default(now())
}

model PriorityAuditLog {
  id          String   @id @default(uuid())
  grievanceId String
  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  oldPriority Urgency
  newPriority Urgency
  oldScore    Float
  newScore    Float
  reason      String?
  updatedAt   DateTime @default(now())
}

model Evidence {
  id          String    @id @default(uuid())
  grievanceId String
  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  fileUrl     String
  fileType    FileType  @default(IMAGE)
  caption     String?
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
}
