POSTGRES_USER=crp_user
POSTGRES_PASSWORD=crp_password
POSTGRES_DB=community_redressal
POSTGRES_PORT=5432

# Redis Cache & BullMQ Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=complaints

# Auth & Secrets
JWT_ACCESS_SECRET=super-secret-access-token-key-32-chars-long
JWT_REFRESH_SECRET=super-secret-refresh-token-key-32-chars-long
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

