# Community Redressal Planner — Environment Variables
# Copy this to .env and fill in your real API keys.

# ─── Core API Server ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development
API_PORT=3001

# ─── Database (PostgreSQL + PostGIS) ─────────────────────────────
DATABASE_URL=postgres://crp_user:crp_password@localhost:5432/community_redressal

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── MinIO Object Storage ─────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=complaints

# ─── JWT Authentication ───────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_32_CHAR_RANDOM_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_32_CHAR_RANDOM_HEX_STRING

# ─── Field Encryption (AES-256-GCM for PII) ──────────────────────
# Must be 64 hex chars (32 bytes)
FIELD_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_STRING

# ─── Email Provider (Resend - recommended) ────────────────────────
# Sign up at https://resend.com — free tier: 3000 emails/month
# SMTP settings for Resend:
RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_API_KEY
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_REPLACE_WITH_YOUR_RESEND_API_KEY
SMTP_FROM=noreply@yourdomain.com

# ─── SMS & OTP (MSG91) ────────────────────────────────────────────
# Sign up at https://msg91.com — DLT registration required for India
# Get Auth Key from: Control Panel → API → Auth Key
MSG91_AUTH_KEY=REPLACE_WITH_YOUR_MSG91_AUTH_KEY
MSG91_SENDER_ID=CIVICR
MSG91_FLOW_ID=REPLACE_WITH_YOUR_MSG91_FLOW_ID

# ─── WhatsApp Business Cloud API ──────────────────────────────────
# Set up at https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=REPLACE_WITH_YOUR_WHATSAPP_PERMANENT_TOKEN
WHATSAPP_PHONE_ID=REPLACE_WITH_YOUR_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_YOUR_WEBHOOK_VERIFY_TOKEN

# ─── Web Push Notifications (VAPID) ──────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=REPLACE_WITH_YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@yourmunicipality.gov.in

# ─── AI Service ──────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─── Frontend (Next.js) ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
